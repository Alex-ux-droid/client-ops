# Пароль для входу в систему (обов'язково на сервері)
APP_PASSWORD=
# Випадковий рядок мінімум 32 символи для підпису сесії
SESSION_SECRET=
# Ключ Anthropic для помічника (етап "чат з агентом")
ANTHROPIC_API_KEY=
# Модель помічника
AGENT_MODEL=
# Шлях до бази (за замовчуванням data/app.db; на сервері /data/app.db)
DATABASE_PATH=
APP_CURRENCY=
AGENT_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Голос і розпізнавання (ElevenLabs) — вводиться в Налаштування → Конектори
ELEVENLABS_API_KEY=

# Telegram-бот — вводиться в Налаштування → Конектори → Telegram (секрет вебхука генерується сам)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Meta Ads (тільки читання) — вводиться в Налаштування → Конектори → Meta Ads
META_ACCESS_TOKEN=
